<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SignAssembly>false</SignAssembly>
    <!-- SDK test projects use glob-based item inclusion. -->
    <EnableFileInclusionValidation>false</EnableFileInclusionValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference KeePassLib (public domain model) and KeePass (for internal
      auto-type/SPR engine methods exposed via InternalsVisibleTo).
    -->
    <ProjectReference Include="..\KeePassLib\KeePassLib.csproj" />
    <ProjectReference Include="..\KeePass.Core\KeePass.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden fixture data embedded as content -->
    <None Update="TestData\AutoType\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
