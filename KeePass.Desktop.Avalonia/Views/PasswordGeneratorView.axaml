<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeePass.Core.ViewModels"
             xmlns:kplib="using:KeePassLib.Cryptography.PasswordGenerator"
             xmlns:ctrl="using:KeePass.Desktop.Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="560"
             x:Class="KeePass.Desktop.Avalonia.Views.PasswordGeneratorView"
             x:DataType="vm:PasswordGeneratorViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="🔐" FontSize="20" VerticalAlignment="Center" />
            <TextBlock Text="Password Generator"
                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">

                <!-- Profile picker -->
                <Grid ColumnDefinitions="*,Auto,Auto" >
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberBinding="{Binding Name}" />
                    <Button Grid.Column="1" Content="Save"   Margin="4,0,0,0"
                            Command="{Binding SaveProfileCommand}" />
                    <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0"
                            Command="{Binding DeleteProfileCommand}" />
                </Grid>

                <Separator />

                <!-- Generation mode tabs -->
                <TabControl>

                    <!-- ── Character Set mode ── -->
                    <TabItem Header="Character Set">
                        <StackPanel Spacing="8" Margin="4">

                            <TextBlock Text="Length" FontSize="11" Opacity="0.7" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        Minimum="4" Maximum="128"
                                        Value="{Binding Length}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" />
                                <NumericUpDown Grid.Column="1"
                                              Minimum="1" Maximum="999"
                                              Value="{Binding Length}"
                                              Width="70" Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="Character Sets" FontSize="11" Opacity="0.7" />
                            <WrapPanel>
                                <CheckBox Content="Upper Case (A–Z)"  IsChecked="{Binding UseUpperCase}"        Margin="0,0,8,4" />
                                <CheckBox Content="Lower Case (a–z)"  IsChecked="{Binding UseLowerCase}"        Margin="0,0,8,4" />
                                <CheckBox Content="Digits (0–9)"      IsChecked="{Binding UseDigits}"           Margin="0,0,8,4" />
                                <CheckBox Content="Special (!@#...)"  IsChecked="{Binding UseSpecial}"          Margin="0,0,8,4" />
                                <CheckBox Content="Brackets (()[]{}&lt;&gt;)" IsChecked="{Binding UseBrackets}" Margin="0,0,8,4" />
                                <CheckBox Content="Latin Supplement"  IsChecked="{Binding UseLatin1}"           Margin="0,0,8,4" />
                            </WrapPanel>

                            <TextBlock Text="Additional Characters" FontSize="11" Opacity="0.7" />
                            <TextBox Text="{Binding CharSetAdditional}"
                                     Watermark="Extra characters to include" />

                            <TextBlock Text="Exclusions" FontSize="11" Opacity="0.7" />
                            <WrapPanel>
                                <CheckBox Content="Exclude look-alike"         IsChecked="{Binding ExcludeLookAlike}"     Margin="0,0,8,4" />
                                <CheckBox Content="No repeating characters"    IsChecked="{Binding NoRepeatingCharacters}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBox Text="{Binding ExcludeCharacters}"
                                     Watermark="Characters to exclude" />

                        </StackPanel>
                    </TabItem>

                    <!-- ── Pattern mode ── -->
                    <TabItem Header="Pattern">
                        <StackPanel Spacing="8" Margin="4">
                            <TextBlock Text="Pattern" FontSize="11" Opacity="0.7" />
                            <TextBox Text="{Binding Pattern}"
                                     Watermark="e.g. {L}{d}{L}{L}{d}{d}" />
                            <CheckBox Content="Permute resulting password"
                                      IsChecked="{Binding PatternPermutePassword}" />
                        </StackPanel>
                    </TabItem>

                </TabControl>

                <Separator />

                <!-- Generated password output -->
                <TextBlock Text="Generated Password" FontSize="11" Opacity="0.7" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="GeneratedPasswordBox"
                             IsReadOnly="True"
                             PasswordChar="●"
                             Watermark="Click Generate…"
                             FontFamily="Courier New,Consolas,Monospace" />
                    <ToggleButton Grid.Column="1" Margin="4,0,0,0"
                                  Content="👁"
                                  Checked="RevealToggle_Checked"
                                  Unchecked="RevealToggle_Unchecked" />
                    <Button Grid.Column="2" Margin="4,0,0,0"
                            Content="Copy"
                            x:Name="CopyButton"
                            Click="CopyButton_Click" />
                </Grid>

                <!-- Quality bar -->
                <ctrl:AvaloniaQualityBar
                    QualityBits="{Binding PasswordQualityBits}"
                    MaxBits="128"
                    Height="18"
                    ShowText="True" />

                <!-- Error message -->
                <TextBlock Text="{Binding GenerationError}"
                           Foreground="Red" FontSize="11"
                           IsVisible="{Binding GenerationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Generate button -->
                <Button Content="⚡ Generate" Classes="accent"
                        Command="{Binding GenerateCommand}"
                        HorizontalAlignment="Center" />

            </StackPanel>
        </ScrollViewer>

        <!-- OK / Close -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Close" x:Name="CloseButton" Click="CloseButton_Click" />
            <Button Content="Use Password" Classes="accent"
                    x:Name="UseButton" Click="UseButton_Click"
                    IsEnabled="{Binding HasGeneratedPassword}" />
        </StackPanel>

    </Grid>
</UserControl>
