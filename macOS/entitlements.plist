<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Hardened runtime entitlements for KeePass on macOS.

        com.apple.security.cs.allow-jit
            Required for .NET's JIT compiler on macOS 10.14+.

        com.apple.security.cs.allow-unsigned-executable-memory
            Required because the .NET runtime dynamically generates
            executable code in writable memory regions.

        com.apple.security.cs.disable-library-validation
            Allows loading third-party frameworks (e.g. Avalonia native
            libraries) that are not signed by Apple or the same team.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
