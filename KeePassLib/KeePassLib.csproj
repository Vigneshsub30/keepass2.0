<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows TFM required while KeePassLib still references System.Windows.Forms
         and System.Drawing. These will be removed in WO-027 (IImageService) and
         WO-034 (decouple KeePassLib from WinForms). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows cross-compilation of Windows-targeted projects on macOS/Linux hosts.
         Has no effect when building on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>

    <!-- Disable SDK item globbing; all sources are listed explicitly below to
         preserve the exact set from the legacy ToolsVersion 3.5 project. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Suppress SDK-generated AssemblyInfo; Properties\AssemblyInfo.cs is the
         authoritative source for version, GUID and copyright attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Disable implicit global usings introduced in .NET 6+ SDK projects to
         avoid shadowing or conflicting with the explicit usings in every file. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Nullable reference types: keep disabled. The legacy codebase was written
         without NRT annotations; enabling would produce thousands of warnings.
         Enable incrementally as part of a dedicated NRT adoption work order. -->
    <Nullable>disable</Nullable>

    <AssemblyName>KeePassLib</AssemblyName>
    <RootNamespace>KeePassLib</RootNamespace>

    <!-- Strong-name signing. The .snk was derived from the dummy KeePassLib.pfx
         (password: 123123) because the .NET Core SDK does not support PFX-based
         signing. Official builds use the separately-stored private key SNK.
         KeePassLib.pfx is retained as-is for reference; signing uses the SNK. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>KeePassLib.snk</AssemblyOriginatorKeyFile>

    <!-- Mirror the legacy project's warning settings. -->
    <WarningLevel>4</WarningLevel>
    <!-- 1591: Missing XML documentation comment. Suppressed to keep parity with
         the legacy project which used <NoWarn>1591</NoWarn>. -->
    <NoWarn>1591</NoWarn>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

