<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Override root Directory.Build.props defaults that are not appropriate
         for a test project: xUnit test runner discovers files via globbing. -->
    <EnableDefaultItems>true</EnableDefaultItems>
    <EnableFileInclusionValidation>false</EnableFileInclusionValidation>
    <!-- Test projects do not ship signed binaries. -->
    <SignAssembly>false</SignAssembly>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>KeePass.Tests</AssemblyName>
    <RootNamespace>KeePass.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeePassLib\KeePassLib.csproj" />
    <ProjectReference Include="..\KeePass.Core\KeePass.Core.csproj" />
    <!-- Required for Windows platform implementation tests (WO-028). -->
    <ProjectReference Include="..\KeePass\KeePass.csproj" />
    <!-- Required for Unix platform implementation tests (WO-029). -->
    <ProjectReference Include="..\KeePass.Platform.Unix\KeePass.Platform.Unix.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Image fixture files for IImageService contract tests. -->
    <EmbeddedResource Include="Fixtures\Images\test16x16.png" />
    <EmbeddedResource Include="Fixtures\Images\test32x32.png" />
    <EmbeddedResource Include="Fixtures\Images\test16.ico" />
    <!-- Config fixture files for AppConfigEx IOptions characterization tests. -->
    <EmbeddedResource Include="Fixtures\Config\default-config.xml" />
    <EmbeddedResource Include="Fixtures\Config\user-config.xml" />
    <EmbeddedResource Include="Fixtures\Config\enforced-config.xml" />
    <!-- Mock version-info files for update-channel unit tests (WO-102). -->
    <EmbeddedResource Include="Fixtures\VersionInfo\stable-version-info.txt" />
    <EmbeddedResource Include="Fixtures\VersionInfo\beta-version-info.txt" />
  </ItemGroup>

</Project>
