  <!-- System.IO.FileSystem.AccessControl provides FileInfo.GetAccessControl(sections)
       and FileInfo.SetAccessControl(FileSecurity) extension methods (FileSystemAclExtensions)
       which replaced the removed File.Get/SetAccessControl(string, …) overloads in .NET Core. -->
  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.*" />
  </ItemGroup>

  <!-- KeePassLib.pfx is a dummy signing key included in source control.
       It is listed here so it appears in the project's file inventory but
       is not compiled. Official builds use the separately-stored private key. -->
  <ItemGroup>
