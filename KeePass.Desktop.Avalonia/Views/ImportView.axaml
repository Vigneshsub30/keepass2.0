<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeePass.Core.ViewModels"
             xmlns:kplib="using:KeePassLib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="KeePass.Desktop.Avalonia.Views.ImportView"
             x:DataType="vm:ImportViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" Text="Import from File"
                   FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">

                <!-- Format selector -->
                <TextBlock Text="Format" FontSize="11" Opacity="0.7" />
                <ListBox ItemsSource="{Binding Formats}"
                         SelectedItem="{Binding SelectedFormat}"
                         MaxHeight="160"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormatProviderViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📄" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Separator />

                <!-- Source files -->
                <TextBlock Text="Source Files" FontSize="11" Opacity="0.7" />
                <Grid ColumnDefinitions="*,Auto">
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding FilePaths}"
                             x:Name="FileList"
                             MaxHeight="100"
                             SelectionMode="Single" />
                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                        <Button Content="Browse…"
                                Command="{Binding BrowseFilesCommand}" />
                        <Button Content="Remove"
                                Click="RemoveFileButton_Click" />
                    </StackPanel>
                </Grid>

                <Separator />

                <!-- Merge strategy -->
                <TextBlock Text="Merge Strategy" FontSize="11" Opacity="0.7" />
                <ComboBox x:Name="MergeCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="MergeCombo_SelectionChanged">
                    <ComboBoxItem Content="Create New UUIDs" Tag="0" />
                    <ComboBoxItem Content="Overwrite Existing" Tag="1" />
                    <ComboBoxItem Content="Keep Existing" Tag="2" />
                    <ComboBoxItem Content="Synchronize" Tag="3" />
                </ComboBox>

                <Separator />

                <!-- Progress -->
                <ProgressBar IsVisible="{Binding IsImporting}"
                             IsIndeterminate="True" Height="6" />
                <ListBox ItemsSource="{Binding StatusMessages}"
                         MaxHeight="80"
                         IsVisible="{Binding StatusMessages.Count, Converter={x:Static ObjectConverters.IsNotNull}}"
                         FontSize="11" />

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Import" Classes="accent"
                    Command="{Binding ImportCommand}"
                    IsEnabled="{Binding CanImport}" />
        </StackPanel>

    </Grid>
</UserControl>
